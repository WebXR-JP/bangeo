# Optional public analytics identifiers for production deployments.
# Leave empty to disable third-party scripts in OSS/dev environments.

NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_ADSENSE_CLIENT=

# Public key for ordinary site analytics. Active only on https://www.bangeo.net.
NEXT_PUBLIC_BANGEO_SITE_ANALYTICS_KEY=

# Separate public key for optional anonymous experiment reports.
# Never place ADMIN_TOKEN in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_BANGEO_ANALYTICS_KEY=
NEXT_PUBLIC_BANGEO_ANALYTICS_INGEST=
NEXT_PUBLIC_BANGEO_ANALYTICS_API=
